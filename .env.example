# Gmail Configuration
# GMAIL_USER: Your full gmail address (e.g., example@gmail.com)
# GMAIL_PASS: Your 16-character 'App Password' from Google (NOT your regular password)
# GMAIL_RECEIVER: Where you want the news alerts sent (optional, defaults to GMAIL_USER)

GMAIL_USER=your_email@gmail.com
GMAIL_PASS=xxxx xxxx xxxx xxxx
GMAIL_RECEIVER=receiver_email@gmail.com

# Google Sheets Configuration
# The name of the Google Sheet created in your Drive
GOOGLE_SHEET_NAME=Brand Tracker DB
# Optional: Raw JSON string of service account credentials (alternative to google_creds.json file)
# GOOGLE_CREDS_JSON='{"type": "service_account", ...}'

